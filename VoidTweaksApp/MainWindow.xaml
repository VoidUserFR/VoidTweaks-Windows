<ui:FluentWindow x:Class="VoidTweaks.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="VoidTweaks" Height="770" Width="1200"
    Icon="VoidTweaks.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="VoidTweaks">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="VoidTweaks.ico" Width="18" Height="18" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Border x:Name="AdminBar" Grid.Row="1" Background="#553A2A14" Padding="16,7" Visibility="Collapsed">
      <DockPanel>
        <ui:Button x:Name="ElevateBtn" DockPanel.Dock="Right" Content="Restart as administrator" Appearance="Caution" Click="Elevate_Click" />
        <TextBlock Text="⚠  Not elevated — admin tweaks are disabled until you restart as administrator." Foreground="#FFEAD9A6" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Padding="20,4,20,10">
      <StackPanel Orientation="Horizontal">
        <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
          <TextBlock Text="MEMORY" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
          <ProgressBar x:Name="RamBar" Width="172" Height="12" Minimum="0" Maximum="100" Margin="0,5,0,0" />
          <TextBlock x:Name="RamText" FontSize="11" Opacity="0.85" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
          <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
          <TextBlock x:Name="CpuText" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
          <TextBlock Text="SYSTEM DISK" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
          <TextBlock x:Name="DiskText" FontSize="13.5" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
          <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
          <TextBlock x:Name="GpuText" FontSize="13.5" Margin="0,5,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="WINDOWS" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
          <TextBlock x:Name="OsText" FontSize="13.5" Margin="0,5,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,2,0,8">
          <Border Width="36" Height="36" CornerRadius="10" Background="#FF07070C" Margin="0,0,11,0">
            <Grid>
              <Ellipse Width="28" Height="28" Stroke="#FFE59A3A" StrokeThickness="3" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse Width="28" Height="28" Stroke="#FFFFD9A0" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse Width="12" Height="12" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="0.8" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="VoidTweaks" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="transparent · reversible · local" FontSize="10.5" Opacity="0.45" />
          </StackPanel>
        </StackPanel>
        <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" PlaceholderText="Search tweaks…" Margin="12,0,12,8" TextChanged="SearchBox_TextChanged" />
        <ScrollViewer>
          <StackPanel x:Name="NavPanel" Margin="8,0,8,0" />
        </ScrollViewer>
      </DockPanel>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="146" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="20,0,20,6">
          <StackPanel Orientation="Horizontal">
            <Viewbox x:Name="HeaderIcon" Width="25" Height="25" Margin="0,0,11,0" VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderTitle" Text="" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="HeaderSub" Text="" Opacity="0.65" FontSize="13" Margin="0,4,0,8" />
          <WrapPanel x:Name="Toolbar">
            <ui:Button x:Name="BoostBtn" Content="⚡ Boost now" Appearance="Primary" Margin="0,0,8,6" Click="BoostBtn_Click" />
            <ui:Button x:Name="ScanBtn" Content="Scan" Margin="0,0,8,6" Click="ScanBtn_Click" />
            <ui:Button x:Name="ApplyAllBtn" Content="Apply all" Appearance="Success" Margin="0,0,8,6" Click="ApplyAllBtn_Click" />
            <ui:Button x:Name="RevertAllBtn" Content="Revert all" Appearance="Danger" Margin="0,0,8,6" Click="RevertAllBtn_Click" />
            <ui:Button x:Name="UndoBtn" Content="Undo last" IsEnabled="False" Margin="0,0,16,6" Click="UndoBtn_Click" />
            <CheckBox x:Name="RestoreCheck" Content="Restore point first" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,6" />
            <CheckBox x:Name="DryCheck" Content="Dry run" VerticalAlignment="Center" Margin="0,0,0,6" />
          </WrapPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Padding="20,2,14,12">
          <ItemsControl x:Name="TweakList" />
        </ScrollViewer>
        <Border Grid.Row="2" Background="#33000000" Margin="14,4,14,14" CornerRadius="10" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Output log" FontSize="11" Opacity="0.5" Margin="0,0,0,4" />
            <ScrollViewer>
              <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#9FE0A6" TextWrapping="NoWrap" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
