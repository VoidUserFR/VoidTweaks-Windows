<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>2.7.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VoidTweaks</AssemblyName>
    <RootNamespace>VoidTweaks</RootNamespace>
    <ApplicationIcon>..\VoidTweaks.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is enabled only for the tray NotifyIcon; keep its global usings out so Color/ProgressBar etc. stay WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\tweaks.json" Link="tweaks.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\presets.json" Link="presets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\OpenTweaks.Actions.ps1" Link="OpenTweaks.Actions.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\i18n.json" Link="i18n.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="..\VoidTweaks.ico" Link="VoidTweaks.ico" />
  </ItemGroup>
</Project>
